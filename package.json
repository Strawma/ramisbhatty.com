{
	"name": "ramisbhatty.com",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "pnpm test:e2e:public && pnpm test:e2e:bookclub",
		"test:e2e:public": "playwright test --config=playwright.config.ts",
		"test:e2e:bookclub": "playwright test --config=playwright.bookclub.config.ts",
		"bookclub:provision-admin": "node scripts/bookclub-provision-admin.mjs",
		"bookclub:reset-invite": "node scripts/bookclub-reset-invite.mjs",
		"bookclub:check-invite": "node scripts/bookclub-check-invite.mjs",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint ."
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@cloudflare/vitest-pool-workers": "^0.18.8",
		"@cloudflare/workers-types": "^5.20260830.1",
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-cloudflare": "8.0.0-next.3",
		"@sveltejs/kit": "3.0.0-next.13",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.4.0",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"mdsvex": "^0.12.8",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.68.0",
		"vite": "^8.2.2",
		"vitest": "^4.1.11",
		"wrangler": "^4.127.1"
	},
	"dependencies": {
		"webaudio-tinysynth": "^1.1.3"
	}
}
